{
  "manifest_version": 3,
  "name": "GitHub Image Lightbox",
  "version": "1.1.0",
  "description": "Opens image and video links on GitHub in a smooth, zoomable lightbox instead of downloading them.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html",
        "player.js"
      ],
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
